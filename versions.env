# Pinned toolchain for Lean verification. Mathlib's `lean-toolchain` at this revision decides the Lean version;
# the kernel replay uses `leanchecker`, which ships with every Lean toolchain since v4.28 (it replaced the
# separate lean4checker repository). To upgrade: pick a newer mathlib tag, update both lines, and re-run the
# `self-test` workflow. v4.33.1 matches the Mathlib pinned by Formal Conjectures (below).
MATHLIB_TAG=v4.33.1
MATHLIB_REV=0df444a360eaa60ab8c11dca51a86af692955474
# Formal Conjectures (google-deepmind/formal-conjectures, Apache-2.0): imported problems pin their statements to its
# theorems. Its lake-manifest must pin the same Mathlib revision as MATHLIB_REV (setup-lean.sh checks this); when
# upgrading, move both together and re-run `pnpm import:problems` so the problem files point at the same commit.
FC_REV=e6d1743831c28f22c83a841d222e2ab59e9bac17
